# ── Custom provider (optional: takes priority over all built-in tiers) ─────
# Use any model supported by litellm (100+ providers). Set LRD_CUSTOM_MODEL
# to the litellm model string; add LRD_CUSTOM_API_KEY for providers that need
# one. LRD_CUSTOM_API_BASE is optional: ollama/ models auto-detect it.
#
# Examples:
#   Fully local (no key needed):
#     LRD_CUSTOM_MODEL=ollama/qwen3.5:0.8b
#
#   Anthropic:
#     LRD_CUSTOM_MODEL=anthropic/claude-haiku-4-5
#     LRD_CUSTOM_API_KEY=sk-ant-...
#
#   OpenAI:
#     LRD_CUSTOM_MODEL=openai/gpt-4o-mini
#     LRD_CUSTOM_API_KEY=sk-...
#
#   GitHub Copilot:
#     LRD_CUSTOM_MODEL=github/gpt-4o
#     LRD_CUSTOM_API_KEY=ghp_...
#
#   Google Vertex AI:
#     LRD_CUSTOM_MODEL=vertex_ai/gemini-2.0-flash
#     LRD_CUSTOM_API_BASE=https://...
#
# LRD_CUSTOM_MODEL=
# LRD_CUSTOM_API_KEY=
# LRD_CUSTOM_API_BASE=

# ── Built-in free-tier provider chain ────────────────────────────────────────
# Used when LRD_CUSTOM_MODEL is not set. Tried in order; all have free tiers.
#
# Tier 1: Hugging Face Inference Providers
#   - Sign up at https://huggingface.co/join (no credit card)
#   - Create a token at https://huggingface.co/settings/tokens (read scope is enough)
#   - One token unlocks 100+ open-weight models across Cerebras, Groq, Together, etc.
HF_TOKEN=

# Tier 2: Google Gemini
#   - Free tier, no credit card (limits: https://ai.google.dev/gemini-api/docs/rate-limits)
#   - Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tier 3: Ollama (fully offline)
#   - Install from https://ollama.com: no key needed
#   - Pull the model under test and the judge:
#     `ollama pull qwen3.5:0.8b` and `ollama pull qwen3.5:4b`
LRD_OLLAMA_BASE_URL=http://localhost:11434

# ── Model selection (optional: defaults work) ──────────────────────────────
# Override the model id used for each built-in provider tier.
# LRD_HF_MODEL=openai/openai/gpt-oss-20b:cheapest
# LRD_GEMINI_MODEL=gemini/gemini-2.0-flash
# LRD_OLLAMA_MODEL=ollama/qwen3.5:0.8b

# Thinking budget for Ollama models: none (default) | low | medium | high.
# Qwen3.5 thinks by default and can spend all of max_tokens on it; none turns it off.
# LRD_REASONING_EFFORT=none

# ── Judge (a separate model: no model grades its own answers) ──────────────
# Any litellm model string. Startup fails if it equals the model under test.
# With HF or Gemini as the model under test, point it at another provider.
# LRD_JUDGE_MODEL=ollama/qwen3.5:4b
# LRD_JUDGE_API_KEY=
# LRD_JUDGE_API_BASE=

# ── Judge consensus (multi-call majority vote) ──────────────────────────────
# 1 = single call (cheapest), 3 = N=3 majority vote (recommended for production
# alerts: dampens judge variance at 3× the token cost). 5 / 7 also supported.
# LRD_JUDGE_CONSENSUS_N=1

# ── Cost estimation ($ per 1M tokens; defaults to $0 = free tier) ───────────
# Set these if you swap to a paid model so the report shows real spend per run.
# LRD_COST_INPUT_USD=0.0
# LRD_COST_OUTPUT_USD=0.0

# ── Webhook notifications (optional) ────────────────────────────────────────
# Platform auto-detected from URL. Leave blank to disable alerts.
#   Slack:        https://hooks.slack.com/services/...
#   Google Chat:  https://chat.googleapis.com/v1/spaces/.../messages?...
#   Discord:      https://discord.com/api/webhooks/...
#   Generic JSON: any other HTTPS endpoint accepting POST
LRD_WEBHOOK_URL=

# Optional override: force a specific platform formatter
# LRD_WEBHOOK_PLATFORM=slack | google_chat | discord | generic

# ── Runtime configuration ───────────────────────────────────────────────────
# LRD_CONCURRENCY = cases evaluated at once (1 to 100).
LRD_LOG_LEVEL=INFO
LRD_CONCURRENCY=10

# ── Dashboard database path ──────────────────────────────────────────────────
# Read by the Streamlit dashboard only. `lrd dashboard --db` sets it for you;
# `lrd run`, `score`, `diff`, `report` and `pr-comment` take `--db` instead.
# Default: evals/runs.db (relative to cwd).
# LRD_DB_PATH=evals/runs.db
